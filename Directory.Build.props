<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      PlatformTarget здесь намеренно не задан. x64 нужен только проектам, работающим
      с DirectInput и WPF, и объявлен в них самих: если навязать x64 всему решению,
      тесты перестают запускаться на arm64-машинах.
    -->
  </PropertyGroup>

  <!--
    Проекты, работающие с железом (DirectInput/HID) и WPF, собираются только под Windows.
    На macOS разрабатывается и тестируется FfbLatency.Analysis — вся математика анализа,
    которая не зависит от платформы и проверяется на синтетических сигналах.
  -->

</Project>
