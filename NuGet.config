<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Локально для этого проекта: только nuget.org.
    Глобальный конфиг пользователя подключает приватный Nexus, который для этих
    пакетов отдаёт 401 и ломает restore. <clear/> отсекает унаследованные источники.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
