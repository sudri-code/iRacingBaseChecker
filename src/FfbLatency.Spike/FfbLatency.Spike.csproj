<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FfbLatency.Spike</RootNamespace>
    <AssemblyName>FfbLatency.Spike</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      TFM намеренно net8.0, а не net8.0-windows: так проект компилируется и на macOS,
      что позволяет проверять код без Windows-машины. Запускается он всё равно только
      под Windows — DirectInput и winmm резолвятся в рантайме.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>
